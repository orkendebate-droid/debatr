# ==============================================================================
# DEBATR — Environment Variables Example
# ==============================================================================
# Скопируйте этот файл в .env для локальной разработки или укажите
# эти переменные в панели управления Vercel (Project Settings -> Environment Variables).

# ------------------------------------------------------------------------------
# 1. Supabase (База данных PostgreSQL и аутентификация)
# ------------------------------------------------------------------------------
# URL вашего проекта Supabase (Settings -> API в личном кабинете Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Публичный анонимный ключ (Anon / Public Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Искусственный интеллект (AI Engine / Rubric Diagnostic)
# ------------------------------------------------------------------------------
# Модель для анализа аргументации (по умолчанию GPT-6 Luna)
AI_MODEL=gpt-6-luna

# API ключ для прямого обращения к нейросети (опционально, если используется прямой API)
AI_API_KEY=sk-your-ai-api-key-here
